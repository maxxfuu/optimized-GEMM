# Machine-specific CUDA flags do NOT live here: clangd evaluates PathMatch in
# a repo .clangd against repo-relative paths, so one committed file can't
# discriminate between machines. Instead each machine keeps its flags in its
# user-level clangd config, which applies to every CUDA project on it:
#
#   Linux desktop:  ~/.config/clangd/config.yaml            (done)
#   macOS laptop:   ~/Library/Preferences/clangd/config.yaml (todo — move the
#                    fragment below there, then delete it from this file)
#
# Portable (machine-independent) settings only below.
Diagnostics:
  # Flag #include lines whose header isn't actually used.
  UnusedIncludes: Strict

# --- former macOS fragment, for migration ------------------------------------
# CUDA linting via clangd on macOS (no real CUDA toolkit — headers only,
# vendored under ~/.local/cuda from NVIDIA's redist archives).
# -nocudalib: don't link libdevice (fixes "Cannot find libdevice for sm_52")
# shim header: declares the legacy kernel-launch API clang expects on a Darwin host
#
#   If:
#     PathMatch: .*\.(cu|cuh)
#   CompileFlags:
#     Add:
#       - --cuda-path=/Users/maxfu/.local/cuda
#       - --cuda-gpu-arch=sm_80
#       - -nocudalib
#       - --no-cuda-version-check
#       - -include/Users/maxfu/.local/cuda/include/clangd_cuda_shim.h
